      "name": "tmp_write_to_ssh",
      "description": "Tool Write /tmp -> SSH Exec Script: shell script redirection to /tmp then ssh execute",
      "step1": {
        "stage": "tool",
        "key_id": "k-open",
        "tool_call": "shell_run",
        "args": {
          "cmd": "echo 'rm -rf /' > /tmp/p.sh"
        }
      },
      "expected1": {
        "decision": "deny",
        "rule_family": "shellguard."
      },
      "step2": {
        "stage": "ssh",
        "key_id": "k-open",
        "action": "exec",
        "host": "app.teknikal.id",
        "user": "deploy",
        "command": "sh /tmp/p.sh"
      },
      "expected2": {
        "decision": "deny",
        "rule_family": "ssh."
      }
    },
    {
