  "oracle_chains": [
    {
      "id": "S01",
      "name": "metadata_to_exfil",
      "description": "HTTP Cloud Metadata -> HTTP Exfil: 169.254.169.254 link-local access then gist POST",
      "step1": {
        "stage": "http",
        "key_id": "k-open",
        "action": "GET",
        "resource": "http://169.254.169.254/latest/meta-data/iam/"
      },
      "expected1": {
        "decision": "deny",
        "rule_family": "shield.prod."
      },
      "step2": {
        "stage": "http",
        "key_id": "k-open",
        "action": "POST",
        "resource": "https://api.github.com/gists",
        "args": {
          "method": "POST"
        }
      },
      "expected2": {
        "decision": "deny",
        "rule_family": "chain."
      }
    },
    {
      "id": "S02",
      "name": "cte_to_http",
      "description": "DB CTE/Subquery Secret -> HTTP POST: query starts with WITH bypassing simple select regex",
      "step1": {
        "stage": "db",
        "key_id": "k-open",
        "args": {
          "database": "analytics",
          "sql": "WITH d AS (SELECT * FROM credentials) SELECT * FROM d"
        }
      },
      "expected1": {
        "decision": "deny",
        "rule_family": "db."
      },
      "step2": {
        "stage": "http",
        "key_id": "k-open",
        "action": "POST",
        "resource": "https://api.github.com/issues",
        "args": {
          "method": "POST"
        }
      },
      "expected2": {
        "decision": "deny",
        "rule_family": "chain."
      }
    },
    {
      "id": "S03",
      "name": "jsonpath_to_exec",
      "description": "K8s Secret jsonpath -> K8s Exec: secret read via jsonpath flag followed by exec",
      "step1": {
        "stage": "k8s",
        "key_id": "k-k8s",
        "args": {
          "verb": "get",
          "resource": "secret",
          "namespace": "dev",
          "flags": [
            "-o",
            "jsonpath={.data}"
          ]
        }
      },
      "expected1": {
        "decision": "deny",
        "rule_family": "k8s."
      },
      "step2": {
        "stage": "k8s",
        "key_id": "k-k8s",
        "args": {
          "verb": "exec",
          "resource": "pod/app",
          "namespace": "dev",
          "flags": [
            "--",
            "sh"
          ]
        }
      },
      "expected2": {
        "decision": "deny",
        "rule_family": "chain."
      }
    },
    {
