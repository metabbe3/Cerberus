# ==============================================================================
# Cerberus Production Environment Variables
# ==============================================================================
# Copy this template to .env before starting the production stack:
#   cp .env.example .env
#
# DO NOT commit .env or commit any secrets to public source control.
# ==============================================================================

# PostgreSQL Connection DSN (Optional)
# System of record for gateway policies, data, and revision history.
# If left empty, Cerberus falls back to local flat-file storage (data/prod.json).
# Example: postgresql://cerberus_user:strongpassword@postgres-host:5432/cerberus?sslmode=require
CERBERUS_PG_DSN=

# Cerberus Engine Admin Token (Required)
# Master bearer token securing the Cerberus Engine API (/v1/admin/*, /v1/decide/*).
# Used by enforcement gates (tap, ssh) to authenticate against the engine.
# Generate a strong 32-byte secret using:
#   openssl rand -base64 32
CERBERUS_ADMIN_TOKEN=

# Cerberus Tap Admin Token (Optional / Recommended)
# Bearer token securing Tap inspection endpoints (/tap/turns, /tap/stats).
# Generate using:
#   openssl rand -base64 32
TAP_ADMIN_TOKEN=
