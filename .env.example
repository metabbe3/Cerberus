# ==============================================================================
# Cerberus Production Environment Variables (12-Factor Compliant)
# ==============================================================================
# Copy this template to .env before starting the production stack:
#   cp .env.example .env
#
# DO NOT commit .env or commit any secrets to public source control.
# Protect .env with restricted file permissions: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE POLICY ENGINE (cerberus)
# ------------------------------------------------------------------------------

# Master bearer token securing the Cerberus engine Admin API and gate authentication. (Default: required, generate: openssl rand -hex 24)
CERBERUS_ADMIN_TOKEN=

# HTTP server listen address for decide, admin, and health endpoints. (Default: :8089)
CERBERUS_ADDR=:8089

# Directory path containing compiled Rego policy bundles. (Default: policies or /policies)
CERBERUS_POLICY_DIR=/policies

# Path to initial/fallback JSON policy data file with teams and agents. (Default: /data/prod.json)
CERBERUS_DATA_FILE=/data/prod.json

# SQLite database file path for buffered audit logging in WAL mode. (Default: /audit/cerberus.db)
CERBERUS_AUDIT_DB=/audit/cerberus.db

# Days to retain daily rotating SQLite audit logs before pruning. (Default: 30)
CERBERUS_AUDIT_RETENTION_DAYS=30

# Per-evaluation timeout budget, e.g. 10ms or 3s. (Default: 3s)
CERBERUS_EVAL_TIMEOUT=3s

# Structured logging verbosity level: debug, info, warn, error. (Default: info)
CERBERUS_LOG_LEVEL=info

# Maximum entries in the LRU decision evaluation cache. (Default: 10000)
CERBERUS_CACHE_SIZE=10000

# PostgreSQL connection DSN system of record for policy data; empty = flat-file mode. (Default: empty, example: postgresql://user:pass@host:5432/cerberus)
CERBERUS_PG_DSN=

# Optional HTTP endpoint URL for asynchronous decision log export. (Default: empty)
CERBERUS_DECISION_LOG_SHIP_URL=

# Base64 or PEM ed25519 public key for verifying signed policy bundles. (Default: empty)
CERBERUS_BUNDLE_PUBKEY=

# Fail-closed enforcement toggle requiring valid agent keys; false = fail-open onboarding. (Default: false)
CERBERUS_REQUIRE_AGENT_KEYS=false

# Trust local caller UID/GID when communicating over Unix domain sockets. (Default: false)
CERBERUS_TRUST_UNIX_SOCKET=false

# Fallback decision action when no explicit policy rule matches: allow or deny. (Default: allow)
CERBERUS_DEFAULT_ACTION=allow

# ------------------------------------------------------------------------------
# 2. INTER-SERVICE ENGINE COMMUNICATION
# ------------------------------------------------------------------------------

# Internal URL used by enforcement gates and Owl dashboard to reach the engine. (Default: http://engine:8089)
CERBERUS_ENGINE_URL=http://engine:8089

# ------------------------------------------------------------------------------
# 3. LLM TAP GATE (cerberus-tap)
# ------------------------------------------------------------------------------

# Upstream target LLM API base URL forwarded by the tap gate. (Default: https://api.anthropic.com)
CERBERUS_TAP_UPSTREAM=https://api.anthropic.com

# 32-byte AES-256 master key (hex or base64) securing upstream credentials in SQLite. Empty = auto-generate to .upstream.key (0600).
CERBERUS_UPSTREAM_MASTER_KEY=

# In-path proxy listen address intercepting agent LLM traffic. (Default: 0.0.0.0:8090)
CERBERUS_TAP_LISTEN=0.0.0.0:8090
CERBERUS_TAP_ADDR=0.0.0.0:8090

# Bearer token securing Tap inspection endpoints /tap/turns and /tap/stats. (Default: empty, generate: openssl rand -hex 24)
TAP_ADMIN_TOKEN=

# Days to retain daily rotating tap databases tap-YYYYMMDD.db. (Default: 14)
CERBERUS_TAP_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# 4. DOCKER ENFORCER & EGRESS PROXY (cerberus-proxy)
# ------------------------------------------------------------------------------

# Docker enforcer proxy listen address for container isolation. (Default: 0.0.0.0:2377)
CERBERUS_PROXY_LISTEN=0.0.0.0:2377

# Upstream Docker daemon socket URL protected by proxy. (Default: unix:///var/run/docker.sock)
CERBERUS_PROXY_DOCKER_HOST=unix:///var/run/docker.sock

# HTTP CONNECT outbound egress proxy listen address shielding production CIDRs. (Default: 0.0.0.0:8088)
CERBERUS_EGRESS_ADDR=0.0.0.0:8088
CERBERUS_PROXY_EGRESS_ADDR=0.0.0.0:8088

# Fallback agent key_id for unauthenticated proxy and egress callers. (Default: k-default-agent)
CERBERUS_PROXY_DEFAULT_KEY=k-default-agent

# ------------------------------------------------------------------------------
# 5. SSH BASTION GATE (cerberus-ssh)
# ------------------------------------------------------------------------------

# SSH bastion server listen address inspecting commands. (Default: 0.0.0.0:2222)
CERBERUS_SSH_LISTEN=0.0.0.0:2222

# Target upstream SSH host for command relay; empty = decide-only audit mode. (Default: empty)
CERBERUS_SSH_UPSTREAM_HOST=

# Target upstream SSH user for command relay. (Default: empty)
CERBERUS_SSH_UPSTREAM_USER=

# File path to upstream private key PEM for SSH relay. (Default: empty)
CERBERUS_SSH_UPSTREAM_KEY=

# Base64 wire-format public key of upstream host to pin host key. (Default: empty)
CERBERUS_SSH_UPSTREAM_HOSTKEY=

# ------------------------------------------------------------------------------
# 6. OWL DASHBOARD (owl)
# ------------------------------------------------------------------------------

# Admin dashboard login password for the Owl web UI. (Default: required, generate: openssl rand -hex 24)
OWL_ADMIN_PASSWORD=

# Secret key used to sign HTTP session cookies for Owl. (Default: required, generate: openssl rand -hex 32)
OWL_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 7. AGENT CREDENTIALS (Quickstart Agent)
# ------------------------------------------------------------------------------

# Generated secret token for agent authentication header X-Tap-Key. (Generate: openssl rand -hex 24)
CERBERUS_AGENT_SECRET=

# Public agent identifier key_id or sha256 hash registered in policy data. (Generate: echo -n "$CERBERUS_AGENT_SECRET" | sha256sum | awk '{print $1}')
CERBERUS_AGENT_KEY=
